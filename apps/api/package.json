{
  "name": "@pokemon-vault/api",
  "version": "0.1.0",
  "private": true,
  "description": "Pokémon Vault production API (NestJS + PostgreSQL + Prisma).",
  "scripts": {
    "dev": "node scripts/guard-port.cjs && tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/generated','dist/src/generated',{recursive:true})\" && node dist/src/main.js",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/generated','dist/src/generated',{recursive:true})\"",
    "start": "node dist/main",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed",
    "db:rollback": "prisma migrate resolve --rolled-back",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "e2e:setup-db": "bash ../../infrastructure/db/setup-test-db.sh",
    "e2e": "playwright test --config=playwright.config.ts",
    "test:contract": "pnpm --filter @pokemon-vault/types typecheck"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@pokemon-vault/config": "workspace:*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/client-runtime-utils": "^7.9.1",
    "argon2": "^0.45.1",
    "bullmq": "^6.1.0",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
