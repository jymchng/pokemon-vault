{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "outDir": "dist",
    "sourceMap": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "strictPropertyInitialization": false
  },
  "include": [
    "src/**/*.ts",
    "prisma/**/*.ts",
    "src/generated/prisma/**/*.d.ts"
  ]
}