// Pokémon Vault — Prisma schema (SQLite)
// Fake DB for the demo storefront. Manages migrations via Prisma.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ── Cards ───────────────────────────────────────────────

model Card {
  id          String  @id
  name        String
  set         String
  cardNumber  String
  rarity      String
  type        String
  grade       String
  condition   String
  image       String
  owned       Boolean @default(true)
  quantity    Int     @default(1)
  acquiredAt  String
  marketPrice Float
  population  Int?
  description String?

  @@index([set])
  @@index([rarity])
}

// ── Products ────────────────────────────────────────────

model Product {
  id           String  @id
  name         String
  category     String
  set          String
  price        Float
  image        String
  stock        Int
  rating       Float
  availability String
  description  String?
  featured     Boolean @default(false)
  trending     Boolean @default(false)

  @@index([category])
}

// ── Booster Packs ───────────────────────────────────────

model Pack {
  slug         String  @id
  name         String
  tagline      String
  price        Float
  cardsPerPack Int
  image        String
  availability String
  oddsCommon   Float
  oddsUncommon Float
  oddsRare     Float
  oddsUltra    Float
  oddsSecret   Float
  contents     String // JSON array string
  featured     Boolean @default(false)
}

// ── Sets ────────────────────────────────────────────────

model Set {
  id          String @id
  name        String
  symbol      String
  releaseYear Int
  totalCards  Int
  collected   Int
  image       String

  @@index([name])
}

// ── Orders ──────────────────────────────────────────────

model Order {
  id               String  @id
  number           String  @unique
  date             String
  total            Float
  status           String
  trackingNumber   String?
  estimatedDelivery String?
  deliveredDate    String?
  address          String
  items            String // JSON array string

  @@index([number])
}

// ── Activity ────────────────────────────────────────────

model ActivityEvent {
  id       String @id
  type     String
  title    String
  subtitle String
  image    String?
  date     String
  xp       Int?
}

// ── Rewards / Leaderboard ───────────────────────────────

model RewardTier {
  id    String @id
  xp    Int
  label String
  icon  String
}

model LeaderboardEntry {
  id          String @id
  rank        Int
  name        String
  handle      String
  xp          Int
  packs       Int
  avatarColor String
}

model WayToWin {
  id          String @id
  title       String
  description String
  icon        String
}

// ── Shipping ────────────────────────────────────────────

model Address {
  id      String @id
  label   String
  name    String
  line1   String
  line2   String?
  city    String
  state   String
  postal  String
  country String
  current Boolean @default(false)
}

model Shipment {
  id               String @id
  orderNumber      String
  status           String
  carrier          String
  trackingNumber   String
  estimatedDelivery String
  deliveredDate    String?
  progress         Int
  items            String // JSON array string
}

// ── Latest Pulls ────────────────────────────────────────

model LatestPull {
  id     String @id
  title  String
  value  Int
  delta  Float
  grader String
}

// ── Platform Pulls (live feed) ──────────────────────────

model PlatformPull {
  id        String @id
  title     String
  condition String
  packPrice String
  value     Int
  time      String
  image     String
}
