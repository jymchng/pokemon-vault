# Pokémon Vault — Web (Next.js) environment
# Copy to .env and adjust. NEVER commit .env.
#
# The storefront consumes the real backend at /api/v1 (proxied server-side by
# next.config.ts rewrites to POKE_VAULT_NEXT_PUBLIC_API_URL). All data comes
# from the backend — there are no static mock fallbacks.

# Real backend base URL (§116) — the Next.js server proxies /api/v1/* here.
POKE_VAULT_NEXT_PUBLIC_API_URL="http://localhost:3001"
