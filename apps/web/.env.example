# Pokémon Vault — Web (Next.js) environment
# Copy to .env and adjust. NEVER commit .env.
#
# G54 naming: every user-facing variable carries the POKE_VAULT_ prefix. The
# next.config.ts bridges POKE_VAULT_NEXT_PUBLIC_* into NEXT_PUBLIC_* (the
# framework contract Next inlines into client bundles) — no unprefixed vars.

# Real backend base URL (§116, G54) — the Next.js server proxies /api/v1/* here.
POKE_VAULT_NEXT_PUBLIC_API_URL="http://localhost:3001"

# Optional: fall back to static demo data when the API is unavailable (dev).
# The backend is the source of truth; this only keeps the UI usable offline.
POKE_VAULT_NEXT_PUBLIC_MOCK_FALLBACK="true"

# Local SQLite dev DB for the web app's own Prisma (G54: prefixed).
POKE_VAULT_DATABASE_URL="file:./dev.db"
