region            = "eu-central-1"
azs               = ["eu-central-1a", "eu-central-1b"]
vpc_cidr          = "10.41.0.0/16"
public_subnets    = ["10.41.1.0/24", "10.41.2.0/24"]
private_subnets   = ["10.41.10.0/24", "10.41.11.0/24"]
zone_name         = "pokemon-vault.dev"
api_domain        = "staging-api.pokemon-vault.dev"
web_domain        = "staging.pokemon-vault.dev"
web_origin        = "https://staging.pokemon-vault.dev"
db_name           = "pokemon_vault"
db_user           = "pv_app"
db_instance_class = "db.t4g.micro"
redis_node_type   = "cache.t4g.micro"
media_bucket      = "pokemon-vault-media-staging"
backup_bucket     = "pokemon-vault-backups-staging"
image_api         = "ghcr.io/jymchng/pokemon-vault/api:<git-sha>"
image_worker      = "ghcr.io/jymchng/pokemon-vault/worker:<git-sha>"
api_desired       = 1
worker_desired    = 1
min_capacity      = 1
max_capacity      = 3
waf_rate_limit    = 1000
alerts_email      = "oncall@pokemon-vault.dev"
