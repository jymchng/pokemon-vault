{
  "name": "pokemon-vault",
  "version": "0.1.0",
  "private": true,
  "description": "Pokémon Vault — monorepo: web storefront, production API, worker, packages, infrastructure & DevOps.",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:web": "pnpm --filter @pokemon-vault/web dev",
    "dev:api": "pnpm --filter @pokemon-vault/api dev",
    "dev:worker": "pnpm --filter @pokemon-vault/worker dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @pokemon-vault/web build",
    "build:api": "pnpm --filter @pokemon-vault/api build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @pokemon-vault/api db:migrate",
    "db:seed": "pnpm --filter @pokemon-vault/api db:seed",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,md}\" \"packages/**/*.{ts,md}\" \"*.md\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,md}\" \"packages/**/*.{ts,md}\" \"*.md\""
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "better-sqlite3",
      "prisma",
      "@prisma/engines",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
