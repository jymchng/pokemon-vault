# Pokémon Vault — environment (root). Copy to .env and adjust.
# NEVER commit .env. This file documents every variable.

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Services (Docker Compose) ──────────────────────────────────────────────
POSTGRES_USER=pokemon
POSTGRES_PASSWORD=pokemon
POSTGRES_DB=pokemon_vault
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=pokemon-vault

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

WEB_PORT=3000
API_PORT=3001

# ── API / Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://pokemon:pokemon@localhost:5432/pokemon_vault?schema=public
REDIS_URL=redis://localhost:6379

# ── Auth ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
# Access token TTL (seconds, default 900 = 15 min)
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token / session TTL (seconds, default 2592000 = 30 days)
REFRESH_TOKEN_TTL_SECONDS=2592000
# Email verification token TTL (seconds, default 86400 = 24 h)
VERIFY_EMAIL_TTL_SECONDS=86400
# Password reset token TTL (seconds, default 3600 = 1 h)
PASSWORD_RESET_TTL_SECONDS=3600

# ── Web ────────────────────────────────────────────────────────────────────
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Object storage (S3-compatible; MinIO locally) ──────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ── Email ──────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_API_KEY=
EMAIL_FROM="Pokémon Vault <no-reply@pokemon-vault.dev>"

# ── Payments (Stripe) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Observability / errors ─────────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_PORT=9464

# ── Secrets management (§56) ───────────────────────────────────────────────
# Provider: env (local/dev) | aws (AWS Secrets Manager) | doppler (Doppler).
# NEVER commit .env; prod resolves secrets from the provider, not git.
SECRETS_PROVIDER=env
# AWS Secrets Manager (SECRETS_PROVIDER=aws) — JSON SecretString, least-priv
# IAM role, rotation enabled.
SECRETS_ARN=
AWS_REGION=
# Doppler (SECRETS_PROVIDER=doppler) — service token scoped to one config.
DOPPLER_TOKEN=
DOPPLER_PROJECT=
DOPPLER_CONFIG=prd

# \u2500\u2500 Checkout pricing (\u00a727) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500
# All pricing is computed server-side (never accepted from the client).
TAX_RATE_PERCENT=0
FLAT_SHIPPING_USD=0
FREE_SHIPPING_THRESHOLD_USD=0
DISCOUNT_RATE_PERCENT=0
