# Pokémon Vault — environment (root). Copy to .env and adjust.
# NEVER commit .env. This file documents every variable.

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Services (Docker Compose) ──────────────────────────────────────────────
POSTGRES_USER=pokemon
POSTGRES_PASSWORD=pokemon
POSTGRES_DB=pokemon_vault
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=pokemon-vault

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

WEB_PORT=3000
API_PORT=3001

# ── API / Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://pokemon:pokemon@localhost:5432/pokemon_vault?schema=public
REDIS_URL=redis://localhost:6379

# ── Auth ───────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# ── Web ────────────────────────────────────────────────────────────────────
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Object storage (S3-compatible; MinIO locally) ──────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ── Email ──────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_API_KEY=
EMAIL_FROM="Pokémon Vault <no-reply@pokemon-vault.dev>"

# ── Payments (Stripe) ──────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Observability / errors ─────────────────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_PORT=9464
