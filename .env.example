# Pokémon Vault — environment (root). Copy to .env and adjust.
# NEVER commit .env. This file documents every variable.
#
# G54 naming: every user-facing environment variable carries the POKE_VAULT_
# prefix. Non-secret tunables default to config/app.toml and are overridden by
# their POKE_VAULT_* env var (see packages/config ENV_OVERRIDES). Secrets are
# env-only. Exceptions (framework contracts, intentionally unprefixed):
#   NODE_ENV  — Node/Next/Nest standard
#   NEXT_PUBLIC_* — derived by apps/web/next.config.ts from POKE_VAULT_NEXT_PUBLIC_*
#     (Next only inlines NEXT_PUBLIC_* into client bundles)

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Services (Docker Compose) ────────────────────────────────────────────────
# The POSTGRES_*/MINIO_*/REDIS_PORT/MAILPIT_* variables configure the service
# CONTAINERS themselves (image contract) — not the application.
POSTGRES_USER=pokemon
POSTGRES_PASSWORD=pokemon
POSTGRES_DB=pokemon_vault
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Application ports (override config/app.toml [server]).
POKE_VAULT_WEB_PORT=3000
POKE_VAULT_API_PORT=3001

# ── API / Database (secrets — env only) ──────────────────────────────────────
POKE_VAULT_DATABASE_URL=postgresql://pokemon:pokemon@localhost:5432/pokemon_vault?schema=public
POKE_VAULT_REDIS_URL=redis://localhost:6379
# Encrypted DB connections (§55): prod defaults to require; dev defaults to
# disable (localhost). Strict environments: verify-full + POKE_VAULT_DATABASE_SSL_CA.
#POKE_VAULT_DATABASE_SSLMODE=require
#POKE_VAULT_DATABASE_SSL_CA=

# ── Auth (secrets — env only) ────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
POKE_VAULT_JWT_SECRET=change-me
POKE_VAULT_JWT_REFRESH_SECRET=change-me
# Auth TTLs (seconds) — defaults in config/app.toml [auth]; overridable here.
#POKE_VAULT_ACCESS_TOKEN_TTL_SECONDS=900
#POKE_VAULT_REFRESH_TOKEN_TTL_SECONDS=2592000
#POKE_VAULT_VERIFY_EMAIL_TTL_SECONDS=86400
#POKE_VAULT_PASSWORD_RESET_TTL_SECONDS=3600
# Password strength rules (config/app.toml [passwordPolicy]).
#POKE_VAULT_PASSWORD_POLICY_MIN_LENGTH=8
#POKE_VAULT_PASSWORD_POLICY_MAX_LENGTH=128
#POKE_VAULT_PASSWORD_POLICY_MIN_CHARACTER_CLASSES=3
#POKE_VAULT_PASSWORD_POLICY_MIN_ENTROPY_BITS=24
# Brute-force protection (config/app.toml [security]).
#POKE_VAULT_LOGIN_RATE_LIMIT=10
#POKE_VAULT_LOGIN_RATE_WINDOW_SECONDS=300

# ── Web ──────────────────────────────────────────────────────────────────────
# CORS / cookie origin allow-list (comma-separated) — config/app.toml [app].
POKE_VAULT_WEB_ORIGIN=http://localhost:3000
# Web → API base URL (bridged to NEXT_PUBLIC_API_URL by next.config.ts).
POKE_VAULT_NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Object storage (config/app.toml [media]) ─────────────────────────────────
#POKE_VAULT_OBJECT_STORAGE=memory
POKE_VAULT_S3_ENDPOINT=http://localhost:9000
POKE_VAULT_S3_BUCKET=pokemon-vault
POKE_VAULT_S3_ACCESS_KEY=minioadmin
POKE_VAULT_S3_SECRET_KEY=minioadmin

# ── Email (config/app.toml [email]) ──────────────────────────────────────────
POKE_VAULT_SMTP_HOST=localhost
POKE_VAULT_SMTP_PORT=1025
POKE_VAULT_EMAIL_API_KEY=
POKE_VAULT_EMAIL_FROM="Pokémon Vault <no-reply@pokemon-vault.dev>"

# ── Payments (config/app.toml [payments]) ────────────────────────────────────
POKE_VAULT_PAYMENT_PROVIDER=test
POKE_VAULT_STRIPE_SECRET_KEY=
POKE_VAULT_STRIPE_WEBHOOK_SECRET=

# ── Observability / errors (config/app.toml [observability]) ─────────────────
POKE_VAULT_SENTRY_DSN=
POKE_VAULT_OTEL_EXPORTER_OTLP_ENDPOINT=
POKE_VAULT_PROMETHEUS_PORT=9464

# ── Secrets management (§56) ─────────────────────────────────────────────────
# Provider: env (local/dev) | aws (AWS Secrets Manager) | doppler (Doppler).
POKE_VAULT_SECRETS_PROVIDER=env
POKE_VAULT_SECRETS_ARN=
POKE_VAULT_AWS_REGION=
POKE_VAULT_DOPPLER_TOKEN=
POKE_VAULT_DOPPLER_PROJECT=
POKE_VAULT_DOPPLER_CONFIG=prd

# ── Checkout pricing (§27) — defaults in config/app.toml [pricing] ───────────
#POKE_VAULT_TAX_RATE_PERCENT=0
#POKE_VAULT_FLAT_SHIPPING_USD=0
#POKE_VAULT_FREE_SHIPPING_THRESHOLD_USD=0
#POKE_VAULT_DISCOUNT_RATE_PERCENT=0

# ── API docs (§85) ───────────────────────────────────────────────────────────
# Swagger UI at /api/v1/docs: always on in dev/staging; in production only
# when POKE_VAULT_API_DOCS_TOKEN is set (docs are then token-protected).
POKE_VAULT_API_DOCS_TOKEN=

# ── Feature flags (§107) — defaults in config/app.toml [featureFlags] ────────
#POKE_VAULT_FEATURE_PACK_OPENING_ENABLED=true
#POKE_VAULT_FEATURE_REWARDS_ENABLED=true
#POKE_VAULT_FEATURE_NEW_CHECKOUT_ENABLED=true

# ── Scheduled jobs / cron (§106) — defaults in config/app.toml [cron] ────────
#POKE_VAULT_CRON_RELEASE_RESERVATIONS=* * * * *
#POKE_VAULT_CRON_PURGE_ABANDONED_CARTS=0 3 * * *
#POKE_VAULT_CRON_EXPIRE_REWARDS=0 * * * *
#POKE_VAULT_CRON_PURGE_STALE_SESSIONS=0 * * * *
#POKE_VAULT_CRON_PURGE_EMAIL_LOGS=30 3 * * *
#POKE_VAULT_CRON_AGGREGATE_ANALYTICS=15 2 * * *
#POKE_VAULT_CRON_DB_MAINTENANCE=45 3 * * *

# ── Retention / cleanup TTLs (§105-106) — config/app.toml [retention] ────────
#POKE_VAULT_CART_TTL_DAYS=30
#POKE_VAULT_EMAIL_LOG_TTL_DAYS=90
#POKE_VAULT_NOTIFICATION_RETENTION_DAYS=730
